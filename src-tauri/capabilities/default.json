{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window (SPEC §11). Plugin permissions are added in the phase that introduces each plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**/*" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**/*" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/**/*" }]
    },
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "core:window:allow-destroy",
    "process:allow-restart",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "$APPDATA/**/*" }, { "path": "$APPCONFIG/**/*" }]
    }
  ]
}
