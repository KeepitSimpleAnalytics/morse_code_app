{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window (SPEC \u00a711). Plugin permissions are added in the phase that introduces each plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    "dialog:allow-save",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/**/*"
        }
      ]
    }
  ]
}
